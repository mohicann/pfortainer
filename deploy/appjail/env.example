# /zdata/apps/pfortainer/.env (600, git에 커밋 금지) — 경로는 jail 안 기준
HOST=0.0.0.0
PORT=11000
# 처음 시작할 때 admin 계정이 이 비밀번호로 만들어진다(이미 있으면 무시). 로그인 후 바로 바꿀 것.
ADMIN_PASSWORD=<openssl rand -base64 18>
SESSION_SECRET=<openssl rand -hex 32>
CONFIG_DB=/opt/pfortainer/data/config.db
METRICS_DB=/opt/pfortainer/data/metrics.db
HOSTD_SOCKET=/run/pfortainer-rs/host.sock
PODMAN_SOCKET=/run/podman/podman.sock
# 메트릭 화면: 게이지 두 칸의 풀, 네트워크 그래프 NIC (fbnas: zdata, zbak, igc3)
METRICS_POOL1=zdata
METRICS_POOL2=zbak
METRICS_NET_IFACE=igc3
