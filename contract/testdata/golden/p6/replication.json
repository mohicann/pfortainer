  {
    "name": "remote_ssh",
    "req": "POST /replication/run {\"last_snapshot\":\"auto-1\",\"source_dataset\":\"zdata/apps\",\"target_path\":\"backup@host:tank/apps\"}",
    "snap": {
      "status": 200,
      "headers": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": {
        "json": {
          "current_snapshot": "auto-3",
          "output": "증분 복제 완료: zdata/apps@auto-3"
        }
      }
    },
    "calls": [
      {
        "cmd": "zfs",
        "args": [
          "list",
          "-t",
          "snapshot",
          "-o",
          "name",
          "-s",
          "creation",
          "-H",
          "zdata/apps"
        ]
      },
      {
        "cmd": "zfs",
        "args": [
          "send",
          "-i",
          "zdata/apps@auto-1",
          "zdata/apps@auto-3"
        ]
      },
      {
        "cmd": "ssh",
        "args": [
          "-o",
          "StrictHostKeyChecking=accept-new",
          "-o",
          "BatchMode=yes",
          "backup@host",
          "zfs",
          "receive",
          "-F",
          "tank/apps"
        ],
        "stdin": "ZFS-STREAM-BYTES"
      }
    ]
  },
