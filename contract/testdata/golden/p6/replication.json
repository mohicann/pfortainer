[
  {
    "name": "first_full",
    "req": "POST /replication/run {\"source_dataset\":\"zdata/apps\",\"target_path\":\"zbak/apps\"}",
    "snap": {
      "status": 200,
      "headers": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": {
        "json": {
          "current_snapshot": "auto-3",
          "output": "전체 복제 완료: zdata/apps@auto-3"
        }
      }
    },
    "calls": [
      {
        "cmd": "zfs",
        "args": [
          "list",
          "-t",
          "snapshot",
          "-o",
          "name",
          "-s",
          "creation",
          "-H",
          "zdata/apps"
        ]
      },
      {
        "cmd": "zfs",
        "args": [
          "list",
          "-t",
          "snapshot",
          "-o",
          "name",
          "-s",
          "creation",
          "-H",
          "zbak/apps"
        ]
      },
      {
        "cmd": "zfs",
        "args": [
          "send",
          "zdata/apps@auto-3"
        ]
      },
      {
        "cmd": "zfs",
        "args": [
          "receive",
          "-F",
          "zbak/apps"
        ],
        "stdin": "ZFS-STREAM-BYTES"
      }
    ]
  },
  {
    "name": "incremental",
    "req": "POST /replication/run {\"last_snapshot\":\"auto-2\",\"source_dataset\":\"zdata/apps\",\"target_path\":\"zbak/apps\"}",
    "snap": {
      "status": 200,
      "headers": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": {
        "json": {
          "current_snapshot": "auto-3",
          "output": "증분 복제 완료: zdata/apps@auto-3"
        }
      }
    },
    "calls": [
      {
        "cmd": "zfs",
        "args": [
          "list",
          "-t",
          "snapshot",
          "-o",
          "name",
          "-s",
          "creation",
          "-H",
          "zdata/apps"
        ]
      },
      {
        "cmd": "zfs",
        "args": [
          "send",
          "-i",
          "zdata/apps@auto-2",
          "zdata/apps@auto-3"
        ]
      },
      {
        "cmd": "zfs",
        "args": [
          "receive",
          "-F",
          "zbak/apps"
        ],
        "stdin": "ZFS-STREAM-BYTES"
      }
    ]
  },
