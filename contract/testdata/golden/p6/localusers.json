[
  {
    "name": "create_full",
    "req": "POST /localusers/create {\"fullname\":\"Bob Kim\",\"password\":\"pw 1\",\"shell\":\"/bin/sh\",\"smb_password\":\"smb\\npw\",\"username\":\"bob\"}",
    "snap": {
      "status": 200,
      "headers": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": {
        "json": {
          "success": true
        }
      }
    },
    "calls": [
      {
        "cmd": "pw",
        "args": [
          "useradd",
          "-n",
          "bob",
          "-m",
          "-s",
          "/bin/sh",
          "-c",
          "Bob Kim"
        ]
      },
      {
        "cmd": "pw",
        "args": [
          "usermod",
          "bob",
          "-h",
          "0"
        ],
        "stdin": "pw 1\n"
      },
      {
        "cmd": "smbpasswd",
        "args": [
          "-a",
          "-s",
          "bob"
        ],
        "stdin": "smb\npw\nsmb\npw\n"
      }
    ]
  },
