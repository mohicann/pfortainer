        "body": "\u003c!DOCTYPE html\u003e\u003chtml lang=\"ko\"\u003e\u003chead\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\u003ctitle\u003e주요 메트릭 - pfortainer\u003c/title\u003e\u003cscript\u003eif (window.top !== window.self) document.documentElement.classList.add('embedded');\u003c/script\u003e\u003clink href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\"\u003e\u003clink href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\" rel=\"stylesheet\"\u003e\u003cstyle\u003e :root { --sidebar-bg: #1a2332; --sidebar-w: 220px; --header-bg: #1f2d3d; --nav-text: #b3c0d1; --nav-active: #2d4263; --content-bg: #f0f2f5; } body { margin: 0; background: var(--content-bg); } /* /desktop 창(iframe) 안에서는 사이드바·상단바 숨김 */ html.embedded .sidebar, html.embedded .topbar { display: none !important; } html.embedded .main { margin-left: 0; } @media (max-width: 767px) { .desktop-link { display: none; } } .sidebar { width: var(--sidebar-w); background: var(--sidebar-bg); min-height: 100vh; position: fixed; top: 0; left: 0; display: flex; flex-direction: column; z-index: 100; } .sidebar-logo { padding: 1.1rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.07); } .sidebar-logo a { color: #fff; font-size: 1.05rem; font-weight: 700; text-decoration: none; } .sidebar-section-btn { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: .7rem 1rem .25rem; background: none; border: none; cursor: pointer; font-size: .67rem; text-transform: uppercase; color: rgba(255,255,255,.28); letter-spacing: .09em; transition: color .15s; } .sidebar-section-btn:hover { color: rgba(255,255,255,.5); } .sidebar-section-btn .chv { font-size: .65rem; transition: transform .2s; } .sidebar-section-btn.collapsed .chv { transform: rotate(-90deg); } .sidebar .nav-link { color: var(--nav-text); padding: 0.5rem 0.85rem; font-size: 0.86rem; display: flex; align-items: center; gap: 0.55rem; border-radius: 5px; margin: 1px 8px; transition: background .12s, color .12s; } .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,0.07); } .sidebar .nav-link.active { color: #fff; background: var(--nav-active); } .sidebar \u003e .nav-collapse { overflow: hidden; } .sidebar-footer { margin-top: auto; padding: 0.75rem 1rem; border-top: 1px solid rgba(255,255,255,0.07); flex-shrink: 0; } .sidebar-nav-scroll { flex: 1; overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.1) transparent; } .main { margin-left: var(--sidebar-w); display: flex; flex-direction: column; min-height: 100vh; } .topbar { background: var(--header-bg); padding: 0.7rem 1.5rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgba(255,255,255,0.07); } .topbar .title { color: #fff; font-size: 0.95rem; font-weight: 500; margin: 0; } .content { flex: 1; padding: 1.5rem; } .badge-running { background: #28a745 !important; } .badge-exited, .badge-stopped { background: #dc3545 !important; } .badge-paused { background: #ffc107 !important; color: #212529 !important; } .badge-created { background: #6c757d !important; } .badge-restarting{ background: #17a2b8 !important; } .stat-card { background: #fff; border-radius: 8px; padding: 1.2rem 1.4rem; border: 1px solid rgba(0,0,0,0.07); } .stat-card .num { font-size: 2rem; font-weight: 700; line-height: 1; margin-bottom: .2rem; } .stat-card .lbl { font-size: .75rem; color: #6c757d; text-transform: uppercase; letter-spacing: .05em; } .card-table { background: #fff; border-radius: 8px; overflow: hidden; border: 1px solid rgba(0,0,0,0.08); } .card-table .ct-header { padding: .75rem 1rem; border-bottom: 1px solid #e9ecef; display: flex; align-items: center; justify-content: space-between; } .card-table table { margin-bottom: 0; font-size: .875rem; } .card-table thead th { background: #f8f9fa; border-bottom: 2px solid #e9ecef; font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: #6c757d; white-space: nowrap; padding: .6rem .75rem; } .card-table tbody tr:hover { background: #fafbfc; } .card-table td { vertical-align: middle; padding: .6rem .75rem; } .cname { font-weight: 500; color: #1a73e8; text-decoration: none; } .cname:hover { text-decoration: underline; } .mono { font-family: 'SF Mono','Fira Code',monospace; font-size: .82rem; color: #6c757d; } .ptag { display: inline-block; background: #e8f0fe; color: #1a73e8; padding: 1px 7px; border-radius: 3px; font-size: .76rem; font-family: monospace; margin: 1px; } \u003c/style\u003e\u003c/head\u003e\u003cbody\u003e\u003cnav class=\"sidebar\"\u003e\u003cdiv class=\"sidebar-logo\"\u003e\u003ca href=\"/appjail\"\u003e\u003ci class=\"bi bi-grid-3x3-gap-fill me-2\" style=\"color:#4d9eff\"\u003e\u003c/i\u003epfortainer\u003c/a\u003e\u003ca href=\"/desktop\" class=\"desktop-link\" title=\"데스크탑 모드\" style=\"float:right;font-weight:400;opacity:.6\"\u003e\u003ci class=\"bi bi-window-stack\"\u003e\u003c/i\u003e\u003c/a\u003e\u003c/div\u003e\u003cdiv class=\"sidebar-nav-scroll\"\u003e\u003cbutton class=\"sidebar-section-btn collapsed\" data-bs-toggle=\"collapse\" data-bs-target=\"#nav-app\" aria-expanded=\"false\"\u003e\u003cspan\u003e앱\u003c/span\u003e\u003ci class=\"bi bi-chevron-down chv\"\u003e\u003c/i\u003e\u003c/button\u003e\u003cdiv class=\"collapse \" id=\"nav-app\"\u003e\u003cul class=\"nav flex-column mb-0 px-0 pb-1\"\u003e\u003cli\u003e\u003ca href=\"/appjail\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-hdd-stack\"\u003e\u003c/i\u003e AppJail\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/containers\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-boxes\"\u003e\u003c/i\u003e Containers\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/files\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-folder2-open\"\u003e\u003c/i\u003e 파일매니저\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\u003cbutton class=\"sidebar-section-btn \" data-bs-toggle=\"collapse\" data-bs-target=\"#nav-system\" aria-expanded=\"true\"\u003e\u003cspan\u003e시스템\u003c/span\u003e\u003ci class=\"bi bi-chevron-down chv\"\u003e\u003c/i\u003e\u003c/button\u003e\u003cdiv class=\"collapse show\" id=\"nav-system\"\u003e\u003cul class=\"nav flex-column mb-0 px-0 pb-1\"\u003e\u003cli\u003e\u003ca href=\"/system\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-pc-display\"\u003e\u003c/i\u003e 시스템\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/metrics\" class=\"nav-link active\"\u003e\u003ci class=\"bi bi-activity\"\u003e\u003c/i\u003e 주요 메트릭\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/storage\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-hdd-network\"\u003e\u003c/i\u003e 스토리지\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/filesystem\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-diagram-3\"\u003e\u003c/i\u003e ZFS 데이터셋\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/snapshots\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-camera\"\u003e\u003c/i\u003e 스케줄 / 스냅샷\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/replications\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-arrow-repeat\"\u003e\u003c/i\u003e 복제\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/network\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-ethernet\"\u003e\u003c/i\u003e 네트워크\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/diagnostics\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-terminal\"\u003e\u003c/i\u003e 진단/로그\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\u003cbutton class=\"sidebar-section-btn collapsed\" data-bs-toggle=\"collapse\" data-bs-target=\"#nav-shares\" aria-expanded=\"false\"\u003e\u003cspan\u003e공유\u003c/span\u003e\u003ci class=\"bi bi-chevron-down chv\"\u003e\u003c/i\u003e\u003c/button\u003e\u003cdiv class=\"collapse \" id=\"nav-shares\"\u003e\u003cul class=\"nav flex-column mb-0 px-0 pb-1\"\u003e\u003cli\u003e\u003ca href=\"/shares\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-folder-fill\"\u003e\u003c/i\u003e 공유 관리\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\u003cbutton class=\"sidebar-section-btn collapsed\" data-bs-toggle=\"collapse\" data-bs-target=\"#nav-admin\" aria-expanded=\"false\"\u003e\u003cspan\u003e관리자\u003c/span\u003e\u003ci class=\"bi bi-chevron-down chv\"\u003e\u003c/i\u003e\u003c/button\u003e\u003cdiv class=\"collapse \" id=\"nav-admin\"\u003e\u003cul class=\"nav flex-column mb-0 px-0 pb-1\"\u003e\u003cli\u003e\u003ca href=\"/alerts\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-bell\"\u003e\u003c/i\u003e 알림 설정\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"/admin/users\" class=\"nav-link \"\u003e\u003ci class=\"bi bi-people\"\u003e\u003c/i\u003e 사용자 관리\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"sidebar-footer\"\u003e\u003ca href=\"/profile\" style=\"display:flex;align-items:center;gap:.4rem;font-size:.75rem;color:rgba(255,255,255,.55);text-decoration:none;margin-bottom:.3rem;padding:0 .85rem\" onmouseover=\"this.style.color='#fff'\" onmouseout=\"this.style.color='rgba(255,255,255,.55)'\"\u003e\u003ci class=\"bi bi-person-circle\"\u003e\u003c/i\u003eviewer1 \u003cspan class=\"badge bg-secondary ms-auto\" style=\"font-size:.65rem\"\u003eviewer\u003c/span\u003e\u003c/a\u003e\u003ca href=\"/logout\" class=\"nav-link text-muted px-0\" style=\"margin:0\"\u003e\u003ci class=\"bi bi-box-arrow-right\"\u003e\u003c/i\u003e\u003cspan style=\"font-size:.8rem\"\u003e로그아웃\u003c/span\u003e\u003c/a\u003e\u003c/div\u003e\u003c/nav\u003e\u003cdiv class=\"main\"\u003e\u003cdiv class=\"topbar\"\u003e\u003cspan class=\"title\"\u003e주요 메트릭\u003c/span\u003e\u003cspan style=\"color:rgba(255,255,255,.4);font-size:.78rem\"\u003e\u003ci class=\"bi bi-circle-fill me-1\" style=\"color:#28a745;font-size:.45rem;vertical-align:middle\"\u003e\u003c/i\u003ePodman \u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"content\"\u003e\u003cscript src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js\"\u003e\u003c/script\u003e\u003cstyle\u003e .gauge-wrap { background: #fff; border-radius: 8px; border: 1px solid rgba(0,0,0,.07); padding: 1.1rem; text-align: center; } .gauge-wrap canvas { max-width: 160px; max-height: 160px; } .gauge-label { font-size: .72rem; color: #6c757d; text-transform: uppercase; letter-spacing: .06em; margin-top: .4rem; } .gauge-val { font-size: 1.5rem; font-weight: 700; line-height: 1; margin-top: .15rem; } .gauge-sub { font-size: .7rem; color: #adb5bd; margin-top: .1rem; } .chart-card { background: #fff; border-radius: 8px; border: 1px solid rgba(0,0,0,.07); } .chart-card-header { padding: .65rem 1rem; border-bottom: 1px solid #e9ecef; display: flex; align-items: center; justify-content: space-between; } .chart-card-body { padding: .75rem 1rem 1rem; } .upd { font-size: .7rem; color: #adb5bd; } \u003c/style\u003e\u003c!-- ── 도넛 게이지 (5초 갱신) ──────────────────────────────────────────── --\u003e\u003cdiv class=\"row g-3 mb-4\" id=\"gauges-row\"\u003e\u003cdiv class=\"col-6 col-md-3\"\u003e\u003cdiv class=\"gauge-wrap\"\u003e\u003ccanvas id=\"g-cpu\"\u003e\u003c/canvas\u003e\u003cdiv class=\"gauge-label\"\u003eCPU\u003c/div\u003e\u003cdiv class=\"gauge-val\" id=\"gv-cpu\"\u003e—\u003c/div\u003e\u003cdiv class=\"gauge-sub\" id=\"gs-cpu\"\u003e\u0026nbsp;\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-6 col-md-3\"\u003e\u003cdiv class=\"gauge-wrap\"\u003e\u003ccanvas id=\"g-ram\"\u003e\u003c/canvas\u003e\u003cdiv class=\"gauge-label\"\u003e메모리\u003c/div\u003e\u003cdiv class=\"gauge-val\" id=\"gv-ram\"\u003e—\u003c/div\u003e\u003cdiv class=\"gauge-sub\" id=\"gs-ram\"\u003e\u0026nbsp;\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-6 col-md-3\"\u003e\u003cdiv class=\"gauge-wrap\"\u003e\u003ccanvas id=\"g-zdata\"\u003e\u003c/canvas\u003e\u003cdiv class=\"gauge-label\"\u003ezdata 풀\u003c/div\u003e\u003cdiv class=\"gauge-val\" id=\"gv-zdata\"\u003e—\u003c/div\u003e\u003cdiv class=\"gauge-sub\" id=\"gs-zdata\"\u003e\u0026nbsp;\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-6 col-md-3\"\u003e\u003cdiv class=\"gauge-wrap\"\u003e\u003ccanvas id=\"g-zboot\"\u003e\u003c/canvas\u003e\u003cdiv class=\"gauge-label\"\u003ezbak 풀\u003c/div\u003e\u003cdiv class=\"gauge-val\" id=\"gv-zboot\"\u003e—\u003c/div\u003e\u003cdiv class=\"gauge-sub\" id=\"gs-zboot\"\u003e\u0026nbsp;\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c!-- ── 시계열 차트 (30초 갱신) ──────────────────────────────────────────── --\u003e\u003cdiv class=\"row g-3\"\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-ethernet me-2\" style=\"color:#4d9eff\"\u003e\u003c/i\u003e네트워크 (igc3)\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-net\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-net\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-hdd me-2\" style=\"color:#51cf66\"\u003e\u003c/i\u003e디스크 I/O\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-disk\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-disk\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-cpu me-2\" style=\"color:#ff6b6b\"\u003e\u003c/i\u003eCPU 히스토리\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-cpuline\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-cpuline\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-database me-2\" style=\"color:#cc5de8\"\u003e\u003c/i\u003eZFS ARC\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-zfs\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-zfs\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-bar-chart-steps me-2\" style=\"color:#ffd43b\"\u003e\u003c/i\u003eLoad Average\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-load\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-load\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-bullseye me-2\" style=\"color:#20c997\"\u003e\u003c/i\u003eZFS ARC 히트율\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-zfshits\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-zfshits\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-shield-lock me-2\" style=\"color:#4d9eff\"\u003e\u003c/i\u003eTailscale\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-ts\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-ts\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"col-12 col-lg-6\"\u003e\u003cdiv class=\"chart-card\"\u003e\u003cdiv class=\"chart-card-header\"\u003e\u003cspan class=\"fw-semibold\" style=\"font-size:.875rem\"\u003e\u003ci class=\"bi bi-diagram-2 me-2\" style=\"color:#ff6b6b\"\u003e\u003c/i\u003eTCP 활성 연결\u003c/span\u003e\u003cspan class=\"upd\" id=\"upd-tcp\"\u003e\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"chart-card-body\"\u003e\u003ccanvas id=\"c-tcp\" height=\"110\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cscript\u003e // ── 공통 유틸 ───────────────────────────────────────────────────────────── function fmtTime(ts) { const d = new Date(ts * 1000); return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0') + ':' + d.getSeconds().toString().padStart(2,'0'); } function fmtBytes(b, decimals=1) { if (b \u003c 1024) return b.toFixed(0) + ' B'; if (b \u003c 1024*1024) return (b/1024).toFixed(decimals) + ' KB'; if (b \u003c 1024*1024*1024) return (b/1024/1024).toFixed(decimals) + ' MB'; return (b/1024/1024/1024).toFixed(decimals) + ' GB'; } function setUpd(id) { const el = document.getElementById(id); if (el) el.textContent = new Date().toLocaleTimeString('ko-KR'); } async function fetchND(chart, after, points) { const r = await fetch(`/api/metrics/data?chart=${chart}\u0026after=${after}\u0026points=${points}`); if (!r.ok) throw new Error(r.status); return r.json(); } function latestRow(data) { return data[0] ?? null; } // ── 도넛 게이지 팩토리 ──────────────────────────────────────────────────── const GAUGE_BG = '#f0f2f5'; function makeGauge(id, color) { return new Chart(document.getElementById(id).getContext('2d'), { type: 'doughnut', data: { datasets: [{ data: [0, 100], backgroundColor: [color, GAUGE_BG], borderWidth: 0, hoverOffset: 0 }] }, options: { cutout: '72%', animation: { duration: 400 }, plugins: { legend: { display: false }, tooltip: { enabled: false } }, events: [] } }); } function updateGauge(chart, pct) { const p = Math.min(100, Math.max(0, pct)); chart.data.datasets[0].data = [p, 100 - p]; chart.update(); } const gCpu = makeGauge('g-cpu', '#4d9eff'); const gRam = makeGauge('g-ram', '#51cf66'); const gZdata = makeGauge('g-zdata', '#ff6b6b'); const gZboot = makeGauge('g-zboot', '#ffd43b'); // ── 게이지 갱신 함수 (5초) ──────────────────────────────────────────────── async function refreshGaugeCPU() { try { const d = await fetchND('system.cpu', -5, 2); const row = latestRow(d.data); if (!row) return; const pct = row.slice(1).reduce((a,b) =\u003e a+b, 0); updateGauge(gCpu, pct); document.getElementById('gv-cpu').textContent = pct.toFixed(1) + '%'; } catch(e) { console.error('gauge cpu', e); } try { const dt = await fetchND('system.cputemp', -5, 2); const rowt = latestRow(dt.data); const temp = rowt ? rowt[1] : 0; document.getElementById('gs-cpu').textContent = temp \u003e 0 ? temp.toFixed(1) + '°C' : ' '; } catch(e) { console.error('gauge cpu temp', e); } } async function refreshGaugeRAM() { try { const d = await fetchND('system.ram', -5, 2); const row = latestRow(d.data); if (!row) return; const labels = d.labels.slice(1); let total = 0, used = 0; labels.forEach((lbl, i) =\u003e { const v = Math.abs(row[i+1]); total += v; if (lbl !== 'free') used += v; }); const pct = total \u003e 0 ? used/total*100 : 0; updateGauge(gRam, pct); document.getElementById('gv-ram').textContent = pct.toFixed(1) + '%'; document.getElementById('gs-ram').textContent = fmtBytes(used*1024*1024) + ' / ' + fmtBytes(total*1024*1024); } catch(e) { console.error('gauge ram', e); } } // chart returns [ts, utilization%, usedMiB, totalMiB] async function refreshGaugePool(chart, gObj, valId, subId) { try { const d = await fetchND(chart, -5, 2); const row = latestRow(d.data); if (!row) return; const pct = row[1]; updateGauge(gObj, pct); document.getElementById(valId).textContent = pct.toFixed(1) + '%'; document.getElementById(subId).textContent = fmtBytes(row[2]*1024*1024) + ' / ' + fmtBytes(row[3]*1024*1024); } catch(e) { console.error('gauge pool', chart, e); } } async function refreshAllGauges() { await Promise.allSettled([ refreshGaugeCPU(), refreshGaugeRAM(), refreshGaugePool('zfspool.zdata', gZdata, 'gv-zdata', 'gs-zdata'), refreshGaugePool('zfspool.zboot', gZboot, 'gv-zboot', 'gs-zboot'), ]); } // ── 시계열 차트 공통 옵션 ───────────────────────────────────────────────── const lineDefaults = { tension: 0.3, pointRadius: 0, borderWidth: 1.8, fill: false }; const COLORS = ['#4d9eff','#ff6b6b','#51cf66','#ffd43b','#cc5de8','#20c997']; function makeLineChart(id, yTickCb) { return new Chart(document.getElementById(id).getContext('2d'), { type: 'line', data: { labels: [], datasets: [] }, options: { animation: false, responsive: true, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 12 } } }, scales: { x: { ticks: { maxTicksLimit: 6, font: { size: 9 } } }, y: { ticks: { font: { size: 9 }, callback: yTickCb } } } } }); } function applyLineData(chart, d, transform) { const rows = [...d.data].reverse(); const labels = d.labels.slice(1); chart.data.labels = rows.map(r =\u003e fmtTime(r[0])); if (chart.data.datasets.length === 0) { chart.data.datasets = labels.map((lbl, i) =\u003e ({ ...lineDefaults, label: lbl, data: [], borderColor: COLORS[i % COLORS.length], })); } labels.forEach((_, i) =\u003e { chart.data.datasets[i].data = rows.map(r =\u003e transform(r[i+1])); }); chart.update('none'); } // ── 시계열 차트 인스턴스 ────────────────────────────────────────────────── const cNet = makeLineChart('c-net', v =\u003e v.toFixed(1) + ' KB/s'); const cDisk = makeLineChart('c-disk', v =\u003e v.toFixed(1) + ' KB/s'); const cZfs = makeLineChart('c-zfs', v =\u003e v.toFixed(0) + ' MiB'); const cLoad = makeLineChart('c-load', v =\u003e v.toFixed(2)); const cZfsHits= makeLineChart('c-zfshits',v =\u003e v.toFixed(1) + '%'); const cTs = makeLineChart('c-ts', v =\u003e v.toFixed(1) + ' KB/s'); const cTcp = makeLineChart('c-tcp', v =\u003e v.toFixed(0)); // CPU 히스토리: 여러 컬럼을 합산해 단일 라인으로 function makeCpuLineChart(id) { return new Chart(document.getElementById(id).getContext('2d'), { type: 'line', data: { labels: [], datasets: [{ ...lineDefaults, label: 'CPU %', data: [], borderColor: '#ff6b6b', backgroundColor: 'rgba(255,107,107,.08)', fill: true, }]}, options: { animation: false, responsive: true, interaction: { mode: 'index', intersect: false }, plugins: { legend: { display: false } }, scales: { x: { ticks: { maxTicksLimit: 6, font: { size: 9 } } }, y: { min: 0, max: 100, ticks: { font: { size: 9 }, callback: v =\u003e v + '%' } } } } }); } const cCpuLine = makeCpuLineChart('c-cpuline'); async function refreshNet() { try { const d = await fetchND('net.igc0', -1800, 60); applyLineData(cNet, d, v =\u003e v); setUpd('upd-net'); } catch(e) { console.error('net', e); } } async function refreshDisk() { try { const d = await fetchND('system.io', -1800, 60); applyLineData(cDisk, d, v =\u003e v); setUpd('upd-disk'); } catch(e) { console.error('disk', e); } } async function refreshCpuLine() { try { const d = await fetchND('system.cpu', -1800, 60); const rows = [...d.data].reverse(); cCpuLine.data.labels = rows.map(r =\u003e fmtTime(r[0])); cCpuLine.data.datasets[0].data = rows.map(r =\u003e r.slice(1).reduce((a,b)=\u003ea+b,0)); cCpuLine.update('none'); setUpd('upd-cpuline'); } catch(e) { console.error('cpuline', e); } } async function refreshZfs() { try { const d = await fetchND('zfs.arc_size', -1800, 60); applyLineData(cZfs, d, v =\u003e v); setUpd('upd-zfs'); } catch(e) { console.error('zfs', e); } } async function refreshLoad() { try { const d = await fetchND('system.load', -1800, 60); applyLineData(cLoad, d, v =\u003e v); setUpd('upd-load'); } catch(e) { console.error('load', e); } } async function refreshZfsHits() { try { const d = await fetchND('zfs.hits', -1800, 60); applyLineData(cZfsHits, d, v =\u003e v); setUpd('upd-zfshits'); } catch(e) { console.error('zfshits', e); } } async function refreshTailscale() { try { const d = await fetchND('net.tailscale0', -1800, 60); applyLineData(cTs, d, v =\u003e v); setUpd('upd-ts'); } catch(e) { console.error('tailscale', e); } } async function refreshTcp() { try { const d = await fetchND('ipv4.tcpsock', -1800, 60); applyLineData(cTcp, d, v =\u003e v); setUpd('upd-tcp'); } catch(e) { console.error('tcp', e); } } async function refreshAllLines() { await Promise.allSettled([ refreshNet(), refreshDisk(), refreshCpuLine(), refreshZfs(), refreshLoad(), refreshZfsHits(), refreshTailscale(), refreshTcp(), ]); } // ── 스케줄 ──────────────────────────────────────────────────────────────── refreshAllGauges(); setInterval(refreshAllGauges, 5000); refreshAllLines(); setInterval(refreshAllLines, 30000); \u003c/script\u003e\u003c/div\u003e\u003c/div\u003e\u003cscript src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"\u003e\u003c/script\u003e\u003cscript\u003e document.addEventListener('DOMContentLoaded', function() { var sections = ['nav-app', 'nav-system', 'nav-shares', 'nav-admin']; sections.forEach(function(id) { var el = document.getElementById(id); if (!el) return; var hasActive = el.querySelector('.nav-link.active'); if (!hasActive) { var stored = localStorage.getItem('pf-' + id); if (stored === 'closed') { el.classList.remove('show'); var btn = el.previousElementSibling; while (btn \u0026\u0026 btn.tagName !== 'BUTTON') btn = btn.previousElementSibling; if (btn) btn.classList.add('collapsed'); } } el.addEventListener('hide.bs.collapse', function() { localStorage.setItem('pf-' + id, 'closed'); }); el.addEventListener('show.bs.collapse', function() { localStorage.setItem('pf-' + id, 'open'); }); }); }); \u003c/script\u003e\u003c/body\u003e\u003c/html\u003e"
